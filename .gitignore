# Virtual env
.venv/
venv/

# Data (kaggle-downloaded, never commit)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Notebook artifacts
.ipynb_checkpoints/
*.ipynb_checkpoints

# Submissions (track via README table, not CSV in git)
submissions/*.csv
submissions/*.parquet
!submissions/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Kaggle kernel pulls — keep only .md extracts
docs/research/competitor_kernels/**/*.ipynb

# Kaggle kernel pulled outputs (CSV/logs from runs)
kernels/*/output/
kernels/run_02_killer_fe/.smoke/
kernels/run_02_killer_fe/.plan2c/
